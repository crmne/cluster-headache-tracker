{
  "settings": {},
  "rules": [
    {
      "patterns": [
        ".*"
      ],
      "properties": {
        "context": "default",
        "pull_to_refresh_enabled": true
      }
    },
    {
      "patterns": [
        "/current_attack$"
      ],
      "properties": {
        "context": "default",
        "pull_to_refresh_enabled": true
      }
    },
    {
      "patterns": [
        "/headache_logs/new$",
        "/headache_logs/.*/edit$"
      ],
      "properties": {
        "context": "modal",
        "pull_to_refresh_enabled": false,
        "modal_style": "page_sheet",
        "modal_dismiss_gesture_enabled": true
      }
    },
    {
      "patterns": [
        "/users/sign_in$",
        "/users/sign_up$",
        "/users/password/new$",
        "/users/password/edit$",
        "/users/password$",
        "/login$",
        "/signup$",
        "/register$"
      ],
      "properties": {
        "context": "modal",
        "pull_to_refresh_enabled": false,
        "modal_style": "large",
        "modal_dismiss_gesture_enabled": true
      }
    },
    {
      "patterns": [
        "/refresh_historical_location$"
      ],
      "properties": {
        "presentation": "refresh",
        "historical_location": true
      }
    },
    {
      "patterns": [
        "/resume_historical_location$"
      ],
      "properties": {
        "presentation": "none",
        "historical_location": true
      }
    }
  ]
}
