<%# locals: (medication:) %>
<div class="card bg-base-100 shadow-md">
  <div class="card-body p-3 sm:p-4">
    <%= form_with model: medication, class: "space-y-4", id: "medication_form" do |form| %>
      <% if medication.errors.any? %>
        <div class="alert alert-error">
          <%= heroicon "x-circle", variant: "mini", class: "w-5 h-5" %>
          <ul class="list-disc list-inside">
            <% medication.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="bg-base-200/50 rounded-lg p-3 space-y-2">
        <%= form.label :name, t("medications.form.name"), class: "text-sm font-semibold block" %>
        <%= form.text_field :name, class: "input input-bordered w-full", required: true, maxlength: 60,
              autocomplete: "off", placeholder: t("medications.form.name_placeholder") %>
      </div>

      <fieldset class="bg-base-200/50 rounded-lg p-3">
        <legend class="text-sm font-semibold mb-2 float-left w-full"><%= t("medications.form.kind") %></legend>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 clear-both">
          <% Medication::KINDS.each do |kind| %>
            <label class="flex items-start gap-2 rounded-lg bg-base-100 p-2 cursor-pointer has-[:checked]:ring-2 has-[:checked]:ring-primary">
              <%= form.radio_button :kind, kind, class: "radio radio-sm radio-primary mt-0.5" %>
              <span>
                <span class="text-sm font-medium block"><%= t("medications.kinds.#{kind}") %></span>
                <span class="text-xs text-base-content/60"><%= t("medications.kind_hints.#{kind}") %></span>
              </span>
            </label>
          <% end %>
        </div>
      </fieldset>

      <div class="bg-base-200/50 rounded-lg p-3 grid grid-cols-2 gap-3">
        <div>
          <%= form.label :default_dose, t("medications.form.default_dose"), class: "text-sm font-semibold block mb-1" %>
          <%= form.number_field :default_dose, min: 0, step: "any", inputmode: "decimal", class: "input input-bordered w-full",
                value: medication.default_dose && MedicationDose.format_amount(medication.default_dose) %>
        </div>
        <div>
          <%= form.label :unit, t("medications.form.unit"), class: "text-sm font-semibold block mb-1" %>
          <%= form.text_field :unit, class: "input input-bordered w-full", list: "medication_units", maxlength: 20,
                placeholder: t("medications.form.unit_placeholder") %>
          <datalist id="medication_units">
            <% Medication::UNITS.each do |unit| %>
              <option value="<%= unit %>">
            <% end %>
          </datalist>
        </div>
        <p class="col-span-2 text-xs text-base-content/60"><%= t("medications.form.default_dose_hint") %></p>
      </div>

      <div class="bg-base-200/50 rounded-lg p-3 space-y-2">
        <%= form.label :frequency, t("medications.form.frequency"), class: "text-sm font-semibold block" %>
        <%= form.select :frequency,
              Medication::FREQUENCIES.map { |frequency| [ t("medications.frequencies.#{frequency}"), frequency ] },
              {}, class: "select select-bordered w-full" %>
        <%= form.text_field :schedule_note, class: "input input-bordered w-full", maxlength: 100,
              placeholder: t("medications.form.schedule_note_placeholder"),
              aria: { label: t("medications.form.schedule_note") } %>
        <p class="text-xs text-base-content/60"><%= t("medications.form.frequency_hint") %></p>
      </div>

      <div class="bg-base-200/50 rounded-lg p-3">
        <span class="text-sm font-semibold block mb-2"><%= t("medications.form.color") %></span>
        <div class="flex flex-wrap gap-2" role="radiogroup" aria-label="<%= t("medications.form.color") %>">
          <% Medication::COLORS.each do |color| %>
            <label class="cursor-pointer">
              <%= form.radio_button :color, color, class: "peer sr-only", checked: medication.display_color == color,
                    aria: { label: color } %>
              <span class="block w-9 h-9 rounded-full ring-offset-2 ring-offset-base-100 peer-checked:ring-2 peer-checked:ring-base-content peer-focus-visible:ring-2"
                    style="background-color: <%= color %>;"></span>
            </label>
          <% end %>
        </div>
      </div>

      <% if medication.persisted? %>
        <label class="flex items-center gap-3 bg-base-200/50 rounded-lg p-3 cursor-pointer">
          <%= form.check_box :archived, { class: "toggle", checked: medication.archived? } %>
          <span>
            <span class="text-sm font-semibold block"><%= t("medications.form.archived") %></span>
            <span class="text-xs text-base-content/60"><%= t("medications.form.archived_hint") %></span>
          </span>
        </label>
      <% end %>

      <%= form.submit t("medications.form.save"), class: "btn btn-primary w-full" %>

      <% content_for :hotwire_button do %>
        <div data-controller="bridge--button" data-bridge-title="<%= t("medications.form.save") %>">
          <%= form.submit t("medications.form.save"), class: "btn", form: "medication_form" %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
