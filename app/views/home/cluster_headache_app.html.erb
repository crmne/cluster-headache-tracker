<% content_for :title, "Cluster Headache App" %>
<% content_for :meta_description, "Free cluster headache app for web, PWA, iOS beta, and Android beta. One-tap attack logging, charts, CSV export, privacy, and doctor-ready reports." %>

<section class="py-16 bg-base-200 sm:py-20">
  <div class="px-4 mx-auto max-w-4xl sm:px-6 lg:px-8 text-center">
    <p class="font-semibold text-primary mb-3"><%= t(".eyebrow") %></p>
    <h1 class="text-4xl font-bold sm:text-5xl"><%= t(".heading") %></h1>
    <p class="mt-6 text-lg text-base-content/70">
      <%= t(".intro") %>
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
      <%= link_to user_signed_in? ? headache_logs_path : new_user_registration_path, class: "btn btn-primary btn-lg" do %>
        <%= heroicon "globe-alt", variant: "mini", class: "w-5 h-5" %>
        <%= t(".use_web_app") %>
      <% end %>
      <a href="https://testflight.apple.com/join/GJsAQqz2" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-lg">
        <%= icon "ios", class: "w-5 h-5", fill: "currentColor" %>
        <%= t(".ios_beta") %>
      </a>
      <a href="<%= android_apk_url %>" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-lg">
        <%= icon "android", class: "w-5 h-5", fill: "currentColor" %>
        <%= t(".android_beta") %>
      </a>
    </div>
  </div>
</section>

<section class="py-16 bg-base-100">
  <div class="px-4 mx-auto max-w-4xl sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <div class="border border-base-content/10 bg-base-200 p-6">
        <%= heroicon "bolt", variant: "mini", class: "w-6 h-6 text-primary mb-4" %>
        <h2 class="text-xl font-bold mb-2"><%= t(".features.one_tap.heading") %></h2>
        <p class="opacity-70"><%= t(".features.one_tap.body") %></p>
      </div>
      <div class="border border-base-content/10 bg-base-200 p-6">
        <%= heroicon "chart-bar", variant: "mini", class: "w-6 h-6 text-secondary mb-4" %>
        <h2 class="text-xl font-bold mb-2"><%= t(".features.charts.heading") %></h2>
        <p class="opacity-70"><%= t(".features.charts.body") %></p>
      </div>
      <div class="border border-base-content/10 bg-base-200 p-6">
        <%= heroicon "lock-closed", variant: "mini", class: "w-6 h-6 text-success mb-4" %>
        <h2 class="text-xl font-bold mb-2"><%= t(".features.private.heading") %></h2>
        <p class="opacity-70"><%= t(".features.private.body") %></p>
      </div>
    </div>
  </div>
</section>

<section class="py-16 bg-base-200">
  <div class="px-4 mx-auto max-w-4xl sm:px-6 lg:px-8">
    <div class="prose prose-lg mx-auto">
      <h2><%= t(".why.heading") %></h2>
      <p>
        <%= t(".why.body") %>
      </p>

      <h2><%= t(".works_with.heading") %></h2>
      <p>
        <%= t(".works_with.body") %>
      </p>
    </div>
  </div>
</section>

<section class="py-12 bg-base-100">
  <div class="px-4 mx-auto max-w-4xl sm:px-6 lg:px-8 text-center">
    <h2 class="text-2xl font-bold mb-3"><%= t(".reports.heading") %></h2>
    <p class="text-base-content/70">
      <%= t(".reports.body") %>
    </p>
    <%= link_to sample_report_path, class: "btn btn-primary mt-6" do %>
      <%= heroicon "document-chart-bar", variant: "mini", class: "w-5 h-5" %>
      <%= t(".reports.view_sample_report") %>
    <% end %>
  </div>
</section>

<%= render "seo_cta", headline: t(".cta_headline") %>
