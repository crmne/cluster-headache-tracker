<section class="py-16 bg-base-200 sm:py-20">
  <div class="px-4 mx-auto max-w-4xl sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold sm:text-4xl xl:text-5xl">
        <%= t("home.faq_section.title") %>
      </h2>
    </div>

    <div class="prose prose-lg mx-auto">
      <p>
        <strong><%= t("home.faq_section.oxygen.question") %></strong><br>
        <%= t("home.faq_section.oxygen.answer") %>
      </p>

      <p>
        <strong><%= t("home.faq_section.free.question") %></strong><br>
        <%= t("home.faq_section.free.answer") %>
      </p>

      <p>
        <strong><%= t("home.faq_section.during_attack.question") %></strong><br>
        <%= t("home.faq_section.during_attack.answer") %>
      </p>

      <p>
        <strong><%= t("home.faq_section.privacy.question") %></strong><br>
        <%= t("home.faq_section.privacy.answer") %>
      </p>
    </div>

    <div class="text-center mt-12">
      <%= link_to faq_path, class: "btn btn-lg btn-outline" do %>
        <%= t("home.faq_section.see_all") %>
        <%= heroicon "arrow-right", variant: "mini", class: "w-5 h-5" %>
      <% end %>
    </div>
  </div>
</section>
