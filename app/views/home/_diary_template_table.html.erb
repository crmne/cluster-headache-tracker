      <tr class="bg-base-200">
        <th>Date</th>
        <th>Start</th>
        <th>End</th>
        <th>Duration</th>
        <th>Intensity</th>
        <th>Medication or oxygen</th>
        <th>Response</th>
        <th>Triggers</th>
        <th>Notes</th>
      </tr>
    </thead>
    <tbody>
      <% 8.times do %>
