<div class="overflow-x-auto print:overflow-visible">
  <table class="table bg-base-100 print:table-sm">
    <thead>
      <tr class="bg-base-200">
        <th><%= t(".date") %></th>
        <th><%= t(".start") %></th>
        <th><%= t(".end") %></th>
        <th><%= t(".duration") %></th>
        <th><%= t(".intensity") %></th>
        <th><%= t(".medication") %></th>
        <th><%= t(".response") %></th>
        <th><%= t(".triggers") %></th>
        <th><%= t(".notes") %></th>
      </tr>
    </thead>
    <tbody>
      <% 8.times do %>
        <tr>
          <td>&nbsp;</td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
