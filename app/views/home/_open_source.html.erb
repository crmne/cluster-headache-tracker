<section class="py-16 bg-base-100 sm:py-20">
  <div class="px-4 mx-auto max-w-4xl sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-2 gap-12">
      <div class="text-center">
        <h3 class="text-2xl font-bold mb-4"><%= t(".open_source.title") %></h3>
        <p class="mb-6 opacity-70">
          <%= t(".open_source.body") %>
        </p>
        <a href="https://github.com/crmne/cluster-headache-tracker" target="_blank" rel="noopener noreferrer"
           class="btn btn-outline">
          <%= icon "github", class: "w-5 h-5", fill: "currentColor" %>
          <%= t(".open_source.github") %> <span class="opacity-60 font-normal"><%= @github_stars %></span>
        </a>
        <%= link_to t(".open_source.why"), open_source_headache_tracker_path, class: "link link-primary block mt-4 font-semibold" %>
      </div>
      <div class="text-center">
        <h3 class="text-2xl font-bold mb-4"><%= t(".sponsor.title") %></h3>
        <p class="mb-6 opacity-70">
          <%= t(".sponsor.body") %>
        </p>
        <a href="https://github.com/sponsors/crmne" target="_blank" rel="noopener noreferrer"
           class="btn btn-primary">
          <%= t(".sponsor.button") %>
          <%= heroicon "heart", variant: "mini", class: "w-5 h-5" %>
        </a>
      </div>
    </div>
  </div>
</section>
