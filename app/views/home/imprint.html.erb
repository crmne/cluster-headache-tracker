<% content_for :title, "Imprint / Impressum" %>
<article class="prose">
  <h1><%= t(".heading") %></h1>

  <% if I18n.locale != I18n.default_locale %>
    <p><em><%= t(".translation_notice_html", english_version: link_to(t(".english_version"), imprint_path(locale: nil))) %></em></p>
  <% end %>

  <h2><%= t(".information.heading") %></h2>
  <p>Carmine Paolino<br>
  Brunnenstr. 169<br>
  10119 Berlin<br>
  <%= t(".information.country") %></p>

  <h2><%= t(".contact.heading") %></h2>
  <p><%= t(".contact.email") %> <a href="mailto:hello@clusterheadachetracker.com">hello@clusterheadachetracker.com</a></p>

  <h2><%= t(".about.heading") %></h2>
  <p><%= t(".about.body") %></p>

  <h2><%= t(".purpose.heading") %></h2>
  <p><%= t(".purpose.intro") %></p>
  <ul>
    <li><%= t(".purpose.tracking") %></li>
    <li><%= t(".purpose.visualization") %></li>
    <li><%= t(".purpose.sharing") %></li>
  </ul>
  <p><%= t(".purpose.not_medical_advice") %></p>

  <h2><%= t(".disclaimer.heading") %></h2>
  <p><%= t(".disclaimer.body") %></p>

  <h2><%= t(".responsibility.heading") %></h2>
  <p><%= t(".responsibility.body") %></p>

  <h2><%= t(".privacy.heading") %></h2>
  <p><%= t(".privacy.body_html", privacy_policy: link_to(t(".privacy.link"), privacy_policy_path, class: "text-indigo-600 hover:text-indigo-800")) %></p>
</article>
