<% content_for :title, "Free Cluster Headache Diary" %>
<% content_for :meta_description, "Free cluster headache diary and tracker for logging attack time, duration, KIP-style intensity, medication, oxygen response, triggers, and notes." %>

<section class="py-16 bg-base-200 sm:py-20">
  <div class="px-4 mx-auto max-w-4xl sm:px-6 lg:px-8 text-center">
    <p class="font-semibold text-primary mb-3"><%= t(".eyebrow") %></p>
    <h1 class="text-4xl font-bold sm:text-5xl"><%= t(".heading") %></h1>
    <p class="mt-6 text-lg text-base-content/70">
      <%= t(".intro") %>
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
      <%= link_to user_signed_in? ? headache_logs_path : new_user_registration_path, class: "btn btn-primary btn-lg" do %>
        <%= heroicon "arrow-right", variant: "mini", class: "w-5 h-5" %>
        <%= t(".start_tracking") %>
      <% end %>
      <%= link_to cluster_headache_diary_template_path, class: "btn btn-outline btn-lg" do %>
        <%= heroicon "document-arrow-down", variant: "mini", class: "w-5 h-5" %>
        <%= t(".get_template") %>
      <% end %>
    </div>
  </div>
</section>

<section class="py-16 bg-base-100">
  <div class="px-4 mx-auto max-w-4xl sm:px-6 lg:px-8">
    <div class="prose prose-lg mx-auto">
      <h2><%= t(".fast.heading") %></h2>
      <p>
        <%= t(".fast.body") %>
      </p>

      <h2><%= t(".records.heading") %></h2>
      <ul>
        <li><%= t(".records.times") %></li>
        <li><%= t(".records.intensity") %></li>
        <li><%= t(".records.medication") %></li>
        <li><%= t(".records.triggers") %></li>
        <li><%= t(".records.symptoms") %></li>
        <li><%= t(".records.reports") %></li>
      </ul>

      <h2><%= t(".appointments.heading") %></h2>
      <p>
        <%= t(".appointments.body") %>
      </p>
    </div>
  </div>
</section>

<section class="py-12 bg-base-100">
  <div class="px-4 mx-auto max-w-4xl sm:px-6 lg:px-8 text-center">
    <h2 class="text-2xl font-bold mb-3"><%= t(".sample.heading") %></h2>
    <p class="text-base-content/70">
      <%= t(".sample.body") %>
    </p>
    <%= link_to sample_report_path, class: "btn btn-primary mt-6" do %>
      <%= heroicon "document-chart-bar", variant: "mini", class: "w-5 h-5" %>
      <%= t(".sample.view_sample_report") %>
    <% end %>
  </div>
</section>

<section class="py-16 bg-base-200">
  <div class="px-4 mx-auto max-w-4xl sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <div class="bg-base-100 border border-base-content/10 p-6">
        <%= heroicon "document-chart-bar", variant: "mini", class: "w-6 h-6 text-primary mb-4" %>
        <h2 class="font-bold text-xl mb-2"><%= t(".cards.sample_report.heading") %></h2>
        <p class="opacity-70 mb-6"><%= t(".cards.sample_report.body") %></p>
        <%= link_to t(".cards.sample_report.link"), sample_report_path, class: "btn btn-sm btn-primary" %>
      </div>
      <div class="bg-base-100 border border-base-content/10 p-6">
        <%= heroicon "user-group", variant: "mini", class: "w-6 h-6 text-secondary mb-4" %>
        <h2 class="font-bold text-xl mb-2"><%= t(".cards.neurology.heading") %></h2>
        <p class="opacity-70 mb-6"><%= t(".cards.neurology.body") %></p>
        <%= link_to t(".cards.neurology.link"), headache_diary_for_neurologist_path, class: "btn btn-sm btn-primary" %>
      </div>
      <div class="bg-base-100 border border-base-content/10 p-6">
        <%= heroicon "beaker", variant: "mini", class: "w-6 h-6 text-success mb-4" %>
        <h2 class="font-bold text-xl mb-2"><%= t(".cards.oxygen.heading") %></h2>
        <p class="opacity-70 mb-6"><%= t(".cards.oxygen.body") %></p>
        <%= link_to t(".cards.oxygen.link"), cluster_headache_oxygen_documentation_path, class: "btn btn-sm btn-primary" %>
      </div>
    </div>
  </div>
</section>

<section class="py-12 bg-base-100">
  <div class="px-4 mx-auto max-w-4xl sm:px-6 lg:px-8">
    <%= render "medical_disclaimer" %>
  </div>
</section>

<%= render "references", references: [
  {
    name: "Harvard Health - Keeping a headache diary",
    url: "https://www.health.harvard.edu/headache-and-migraine/keeping-a-headache-diary",
    description: t(".references.harvard_health")
  },
  {
    name: "National Headache Foundation - Tracking Diaries",
    url: "https://headaches.org/resources/headache-diary-keeping-a-diary-can-help-your-doctor-help-you/",
    description: t(".references.tracking_diaries")
  },
  {
    name: "National Headache Foundation - Cluster Headache",
    url: "https://headaches.org/resources/cluster-headache/",
    description: t(".references.cluster_headache")
  }
] %>

<%= render "seo_cta" %>
