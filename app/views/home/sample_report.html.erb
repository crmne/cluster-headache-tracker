<% content_for :title, "Sample Cluster Headache Report" %>
<% content_for :meta_description, "Public fictional sample cluster headache report showing attack summaries, timing, intensity, treatment response notes, charts, and detailed log entries." %>

<section class="py-16 bg-base-200 sm:py-20 print:hidden">
  <div class="px-4 mx-auto max-w-4xl sm:px-6 lg:px-8 text-center">
    <p class="font-semibold text-primary mb-3"><%= t(".eyebrow") %></p>
    <h1 class="text-4xl font-bold sm:text-5xl"><%= t(".heading") %></h1>
    <p class="mt-6 text-lg text-base-content/70">
      <%= t(".intro") %>
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
      <button type="button" class="btn btn-primary btn-lg" onclick="window.print()">
        <%= heroicon "printer", variant: "mini", class: "w-5 h-5" %>
        <%= t(".print_sample") %>
      </button>
      <%= link_to user_signed_in? ? headache_logs_path : new_user_registration_path, class: "btn btn-outline btn-lg" do %>
        <%= heroicon "arrow-right", variant: "mini", class: "w-5 h-5" %>
        <%= t(".start_my_report") %>
      <% end %>
    </div>
  </div>
</section>

<section class="py-12 bg-base-100 print:py-0 print:bg-white">
  <div class="container mx-auto px-4 print:m-0 print:w-full print:p-0 print:max-w-none">
    <div class="alert border border-info/20 bg-info/10 text-base-content mb-6 print:hidden">
      <%= heroicon "information-circle", variant: "mini", class: "w-5 h-5 text-info" %>
      <div>
        <h2 class="font-bold"><%= t(".demo_notice.heading") %></h2>
        <p class="text-sm opacity-80">
          <%= t(".demo_notice.body") %>
        </p>
      </div>
    </div>

    <%= render "shared/headache_report",
          user: @sample_user,
          headache_logs: @sample_headache_logs,
          chart_data: @sample_chart_data,
          show_filters: false,
          show_print_instructions: false,
          live_updates: false,
          report_title: t(".report_title") %>
  </div>
</section>

<section class="py-16 bg-base-200 print:hidden">
  <div class="px-4 mx-auto max-w-4xl sm:px-6 lg:px-8">
    <div class="prose prose-lg mx-auto">
      <h2><%= t(".report_contents.heading") %></h2>
      <ul>
        <li><%= t(".report_contents.attack_table") %></li>
        <li><%= t(".report_contents.frequency") %></li>
        <li><%= t(".report_contents.trends") %></li>
        <li><%= t(".report_contents.notes") %></li>
        <li><%= t(".report_contents.csv_export") %></li>
        <li><%= t(".report_contents.share_links") %></li>
      </ul>

      <h2><%= t(".privacy.heading") %></h2>
      <p>
        <%= t(".privacy.body") %>
      </p>
    </div>
  </div>
</section>

<section class="py-12 bg-base-100 print:hidden">
  <div class="px-4 mx-auto max-w-4xl sm:px-6 lg:px-8">
    <%= render "medical_disclaimer" %>
  </div>
</section>

<div class="print:hidden">
  <%= render "seo_cta", headline: t(".cta_headline") %>
</div>
