<% content_for :title, "Cluster Headache Diary Template" %>
<% content_for :meta_description, "Printable cluster headache diary template for attack time, duration, intensity, medication, oxygen response, triggers, and notes." %>

<section class="py-16 bg-base-200 sm:py-20 print:hidden">
  <div class="px-4 mx-auto max-w-4xl sm:px-6 lg:px-8 text-center">
    <p class="font-semibold text-primary mb-3"><%= t(".eyebrow") %></p>
    <h1 class="text-4xl font-bold sm:text-5xl"><%= t(".heading") %></h1>
    <p class="mt-6 text-lg text-base-content/70">
      <%= t(".intro") %>
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8 print:hidden">
      <button type="button" class="btn btn-primary btn-lg" onclick="window.print()">
        <%= heroicon "printer", variant: "mini", class: "w-5 h-5" %>
        <%= t(".print_template") %>
      </button>
      <%= link_to user_signed_in? ? headache_logs_path : new_user_registration_path, class: "btn btn-outline btn-lg" do %>
        <%= heroicon "arrow-right", variant: "mini", class: "w-5 h-5" %>
        <%= t(".start_tracking") %>
      <% end %>
    </div>
  </div>
</section>

<section class="py-12 bg-base-100 print:py-0 print:bg-white">
  <div class="px-4 mx-auto max-w-6xl sm:px-6 lg:px-8">
    <div class="hidden print:block print:mb-8">
      <h1 class="text-2xl font-bold text-black"><%= t(".print_heading") %></h1>
      <p class="mt-2 text-sm text-black">
        <%= t(".print_fields") %>
      </p>
    </div>

    <div class="mb-6 print:hidden">
      <h2 class="text-2xl font-bold mb-2"><%= t(".sheet.heading") %></h2>
      <p class="text-base-content/70">
        <%= t(".sheet.body") %>
      </p>
    </div>

    <%= render "diary_template_table" %>
  </div>
</section>

<section class="py-16 bg-base-200 print:hidden">
  <div class="px-4 mx-auto max-w-4xl sm:px-6 lg:px-8">
    <div class="prose prose-lg mx-auto">
      <h2><%= t(".app_vs_paper.heading") %></h2>
      <p>
        <%= t(".app_vs_paper.body") %>
      </p>
    </div>
  </div>
</section>

<section class="py-12 bg-base-100 print:hidden">
  <div class="px-4 mx-auto max-w-4xl sm:px-6 lg:px-8">
    <%= render "medical_disclaimer" %>
  </div>
</section>

<div class="print:hidden">
  <%= render "references", references: [
    {
      name: "Harvard Health - Keeping a headache diary",
      url: "https://www.health.harvard.edu/headache-and-migraine/keeping-a-headache-diary",
      description: t(".references.harvard_health")
    },
    {
      name: "National Headache Foundation - Tracking Diaries",
      url: "https://headaches.org/resources/headache-diary-keeping-a-diary-can-help-your-doctor-help-you/",
      description: t(".references.tracking_diaries")
    }
  ] %>
</div>

<%= render "seo_cta", headline: t(".cta_headline") %>
