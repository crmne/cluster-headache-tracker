<% content_for :title, "Cluster Headache Oxygen Documentation" %>
<% content_for :meta_description, "Track cluster headache attack frequency, duration, oxygen use, and treatment response for clinician and insurance conversations without making treatment promises." %>

<section class="py-16 bg-base-200 sm:py-20">
  <div class="px-4 mx-auto max-w-4xl sm:px-6 lg:px-8 text-center">
    <p class="font-semibold text-primary mb-3"><%= t(".eyebrow") %></p>
    <h1 class="text-4xl font-bold sm:text-5xl"><%= t(".heading") %></h1>
    <p class="mt-6 text-lg text-base-content/70">
      <%= t(".intro") %>
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
      <%= link_to user_signed_in? ? headache_logs_path : new_user_registration_path, class: "btn btn-primary btn-lg" do %>
        <%= heroicon "arrow-right", variant: "mini", class: "w-5 h-5" %>
        <%= t(".start_tracking") %>
      <% end %>
      <%= link_to sample_report_path, class: "btn btn-outline btn-lg" do %>
        <%= heroicon "document-chart-bar", variant: "mini", class: "w-5 h-5" %>
        <%= t(".view_sample_report") %>
      <% end %>
    </div>
  </div>
</section>

<section class="py-12 bg-base-100">
  <div class="px-4 mx-auto max-w-4xl sm:px-6 lg:px-8">
    <%= render "medical_disclaimer" %>
  </div>
</section>

<section class="py-16 bg-base-200">
  <div class="px-4 mx-auto max-w-4xl sm:px-6 lg:px-8">
    <div class="prose prose-lg mx-auto">
      <h2><%= t(".what_to_document.heading") %></h2>
      <p>
        <%= t(".what_to_document.body") %>
      </p>

      <ul>
        <li><%= t(".what_to_document.attacks_per_period") %></li>
        <li><%= t(".what_to_document.attack_length") %></li>
        <li><%= t(".what_to_document.oxygen_timing") %></li>
        <li><%= t(".what_to_document.attacks_return") %></li>
        <li><%= t(".what_to_document.clinician_notes") %></li>
      </ul>

      <h2><%= t(".how_it_helps.heading") %></h2>
      <p>
        <%= t(".how_it_helps.body") %>
      </p>
    </div>
  </div>
</section>

<section class="py-16 bg-base-100">
  <div class="px-4 mx-auto max-w-4xl sm:px-6 lg:px-8">
    <h2 class="text-2xl font-bold mb-6"><%= t(".examples.heading") %></h2>
    <div class="overflow-x-auto">
      <table class="table bg-base-100">
        <thead>
          <tr class="bg-base-200">
            <th><%= t(".examples.attack") %></th>
            <th><%= t(".examples.duration") %></th>
            <th><%= t(".examples.intensity") %></th>
            <th><%= t(".examples.logged_treatment") %></th>
            <th><%= t(".examples.response_note") %></th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><%= format_time Time.zone.local(2026, 1, 15, 2, 10), :day_and_time %></td>
            <td><%= t(".examples.minutes", count: 45) %></td>
            <td><span class="badge badge-error">8/10</span></td>
            <td><%= t(".examples.oxygen_minutes", count: 15) %></td>
            <td><%= t(".examples.first_response") %></td>
          </tr>
          <tr>
            <td><%= format_time Time.zone.local(2026, 1, 16, 1, 42), :day_and_time %></td>
            <td><%= t(".examples.minutes", count: 52) %></td>
            <td><span class="badge badge-error">9/10</span></td>
            <td><%= t(".examples.oxygen_minutes", count: 20) %></td>
            <td><%= t(".examples.second_response") %></td>
          </tr>
          <tr>
            <td><%= format_time Time.zone.local(2026, 1, 18, 22, 18), :day_and_time %></td>
            <td><%= t(".examples.minutes", count: 38) %></td>
            <td><span class="badge badge-warning">7/10</span></td>
            <td><%= t(".examples.sumatriptan") %></td>
            <td><%= t(".examples.third_response") %></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<%= render "references", references: [
  {
    name: "Mayo Clinic - Cluster headache diagnosis and treatment",
    url: "https://www.mayoclinic.org/diseases-conditions/cluster-headache/diagnosis-treatment/drc-20352084",
    description: t(".references.mayo_clinic")
  },
  {
    name: "American Migraine Foundation - Cluster Headache Treatment Options",
    url: "https://americanmigrainefoundation.org/resource-library/cluster-headache-treatment-options/",
    description: t(".references.american_migraine_foundation")
  },
  {
    name: "Medical News Today - Oxygen for headaches",
    url: "https://www.medicalnewstoday.com/articles/oxygen-for-headaches",
    description: t(".references.medical_news_today")
  }
] %>

<%= render "seo_cta", headline: t(".cta_headline") %>
