<section class="py-16 bg-base-100 sm:py-20">
  <div class="px-4 mx-auto max-w-7xl sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl font-bold sm:text-4xl xl:text-5xl">
        <%= t(".title") %>
      </h2>
      <p class="mt-4 text-lg opacity-60">
        <%= t(".subtitle") %>
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 mt-14 md:grid-cols-3">
      <div class="border border-base-content/10 bg-base-200 p-6">
        <%= heroicon "clipboard-document-list", variant: "mini", class: "w-6 h-6 text-primary mb-4" %>
        <h3 class="text-xl font-bold mb-2"><%= t(".diary.title") %></h3>
        <p class="opacity-60 mb-6"><%= t(".diary.body") %></p>
        <%= link_to t(".diary.link"), cluster_headache_diary_path, class: "btn btn-sm btn-primary" %>
      </div>

      <div class="border border-base-content/10 bg-base-200 p-6">
        <%= heroicon "document-arrow-down", variant: "mini", class: "w-6 h-6 text-secondary mb-4" %>
        <h3 class="text-xl font-bold mb-2"><%= t(".template.title") %></h3>
        <p class="opacity-60 mb-6"><%= t(".template.body") %></p>
        <%= link_to t(".template.link"), cluster_headache_diary_template_path, class: "btn btn-sm btn-primary" %>
      </div>

      <div class="border border-base-content/10 bg-base-200 p-6">
        <%= heroicon "document-chart-bar", variant: "mini", class: "w-6 h-6 text-info mb-4" %>
        <h3 class="text-xl font-bold mb-2"><%= t(".sample_report.title") %></h3>
        <p class="opacity-60 mb-6"><%= t(".sample_report.body") %></p>
        <%= link_to t(".sample_report.link"), sample_report_path, class: "btn btn-sm btn-primary" %>
      </div>

      <div class="border border-base-content/10 bg-base-200 p-6">
        <%= heroicon "user-group", variant: "mini", class: "w-6 h-6 text-accent mb-4" %>
        <h3 class="text-xl font-bold mb-2"><%= t(".neurology_visits.title") %></h3>
        <p class="opacity-60 mb-6"><%= t(".neurology_visits.body") %></p>
        <%= link_to t(".neurology_visits.link"), headache_diary_for_neurologist_path, class: "btn btn-sm btn-primary" %>
      </div>

      <div class="border border-base-content/10 bg-base-200 p-6">
        <%= heroicon "beaker", variant: "mini", class: "w-6 h-6 text-success mb-4" %>
        <h3 class="text-xl font-bold mb-2"><%= t(".oxygen.title") %></h3>
        <p class="opacity-60 mb-6"><%= t(".oxygen.body") %></p>
        <%= link_to t(".oxygen.link"), cluster_headache_oxygen_documentation_path, class: "btn btn-sm btn-primary" %>
      </div>

      <div class="border border-base-content/10 bg-base-200 p-6">
        <%= heroicon "device-phone-mobile", variant: "mini", class: "w-6 h-6 text-warning mb-4" %>
        <h3 class="text-xl font-bold mb-2"><%= t(".app.title") %></h3>
        <p class="opacity-60 mb-6"><%= t(".app.body") %></p>
        <%= link_to t(".app.link"), cluster_headache_app_path, class: "btn btn-sm btn-primary" %>
      </div>
    </div>
  </div>
</section>
