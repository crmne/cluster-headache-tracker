<section id="testimonials" class="py-16 bg-base-200 sm:py-20">
  <div class="px-4 mx-auto max-w-7xl sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center mb-14">
      <h2 class="text-3xl font-bold sm:text-4xl xl:text-5xl">
        <%= t(".title") %>
      </h2>
      <p class="mt-4 text-lg opacity-60">
        <%= t(".subtitle") %>
      </p>
    </div>

    <div class="max-w-4xl mx-auto space-y-8">
      <div class="rounded-2xl bg-base-100 p-8 sm:p-10">
        <blockquote class="text-xl leading-relaxed sm:text-2xl">
          <p><%= t(".oxygen.quote_html") %></p>
        </blockquote>
        <div class="mt-6">
          <p class="font-bold"><%= t(".oxygen.author") %></p>
          <p class="text-sm opacity-60"><%= t(".oxygen.context") %></p>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <div class="rounded-2xl bg-base-100 p-8">
          <blockquote class="leading-relaxed">
            <p><%= t(".charts.quote_html") %></p>
          </blockquote>
          <div class="mt-6">
            <p class="font-bold"><%= t(".charts.author") %></p>
            <p class="text-sm opacity-60"><%= t(".charts.context") %></p>
          </div>
        </div>

        <div class="rounded-2xl bg-base-100 p-8">
          <blockquote class="leading-relaxed">
            <p><%= t(".manual_tracker.quote_html") %></p>
          </blockquote>
          <div class="mt-6">
            <p class="font-bold"><%= t(".manual_tracker.author") %></p>
            <p class="text-sm opacity-60"><%= t(".manual_tracker.context") %></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
