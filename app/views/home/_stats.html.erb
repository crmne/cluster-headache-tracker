<section class="py-16 bg-primary text-primary-content sm:py-20">
  <div class="px-4 mx-auto max-w-7xl sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl font-bold sm:text-4xl xl:text-5xl">
        <%= t(".title") %>
      </h2>
      <p class="mt-6 text-lg opacity-80 max-w-2xl mx-auto">
        <%= t(".body") %>
      </p>
    </div>

    <div class="grid grid-cols-1 mt-14 text-center gap-y-10 gap-x-8 sm:grid-cols-3">
      <div class="px-4">
        <p class="text-5xl font-bold"><%= t(".one_tap.title") %></p>
        <p class="mt-4 text-lg opacity-80">
          <%= t(".one_tap.body") %>
        </p>
      </div>

      <div class="px-4">
        <p class="text-5xl font-bold"><%= t(".real_data.title") %></p>
        <p class="mt-4 text-lg opacity-80">
          <%= t(".real_data.body") %>
        </p>
      </div>

      <div class="px-4">
        <p class="text-5xl font-bold"><%= t(".patterns.title") %></p>
        <p class="mt-4 text-lg opacity-80">
          <%= t(".patterns.body") %>
        </p>
      </div>
    </div>
  </div>
</section>
