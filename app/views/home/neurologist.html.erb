<% content_for :title, "Cluster Headache Tracker for Neurologists" %>
<% content_for :meta_description, "Free cluster headache tracking tool your patients can use for clean attack history, clear patterns, and treatment-response documentation." %>

<!-- Hero Section -->
<section class="py-20">
  <div class="container mx-auto px-4 max-w-4xl text-center">
    <h1 class="text-4xl font-bold mb-4"><%= t(".heading") %></h1>
    <p class="text-xl text-base-content/70"><%= t(".subheading") %></p>
  </div>
</section>

<!-- Main Content -->
<section class="py-20 bg-base-100">
  <div class="container mx-auto px-4 max-w-4xl">
    <div class="prose prose-lg mx-auto">
      <p class="text-xl"><%= t(".intro") %></p>

      <h2><%= t(".why.heading") %></h2>

      <p><%= t(".why.during_attack") %></p>

      <p><%= t(".why.simple") %></p>

      <h2><%= t(".data.heading") %></h2>

      <p><strong><%= t(".data.attack_includes") %></strong></p>
      <ul>
        <li><%= t(".data.attack.times") %></li>
        <li><%= t(".data.attack.intensity") %></li>
        <li><%= t(".data.attack.medications") %></li>
        <li><%= t(".data.attack.triggers") %></li>
        <li><%= t(".data.attack.side") %></li>
      </ul>

      <p><strong><%= t(".data.reports_show") %></strong></p>
      <ul>
        <li><%= t(".data.reports.frequency") %></li>
        <li><%= t(".data.reports.cluster_periods") %></li>
        <li><%= t(".data.reports.circadian") %></li>
        <li><%= t(".data.reports.treatment_response") %></li>
        <li><%= t(".data.reports.medication_history") %></li>
      </ul>

      <h2><%= t(".sharing.heading") %></h2>

      <p><%= t(".sharing.intro_html") %></p>
      <ul>
        <li><%= t(".sharing.tables") %></li>
        <li><%= t(".sharing.charts") %></li>
        <li><%= t(".sharing.medication_graphs") %></li>
        <li><%= t(".sharing.print") %></li>
      </ul>

      <p><%= t(".sharing.feedback") %></p>

      <h2><%= t(".friction.heading") %></h2>

      <p><strong><%= t(".friction.for_patients_label") %></strong> <%= t(".friction.for_patients") %></p>

      <p><strong><%= t(".friction.for_you_label") %></strong> <%= t(".friction.for_you") %></p>

      <p><%= t(".friction.thats_it") %></p>

      <h2><%= t(".privacy.heading") %></h2>

      <p><%= t(".privacy.no_tracking") %></p>

      <p><%= t(".privacy.ownership") %></p>

      <h2><%= t(".tell_patients.heading") %></h2>

      <p class="text-xl"><%= t(".tell_patients.just_say_html") %></p>

      <p><%= t(".tell_patients.result") %></p>
    </div>

    <div class="text-center mt-12">
      <p class="text-lg mb-4"><%= t(".contact.questions") %></p>
      <a href="mailto:hello@clusterheadachetracker.com" class="text-xl link">hello@clusterheadachetracker.com</a>

      <p class="mt-8 text-sm text-base-content/60">
        <%= t(".contact.built_by") %>
      </p>
    </div>
  </div>
</section>
