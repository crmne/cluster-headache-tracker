<% content_for :title, "Cluster Headache Tracker FAQ" %>
<% content_for :meta_description, faq_meta_description %>

<!-- Hero Section -->
<section class="py-20">
  <div class="container mx-auto px-4 max-w-4xl text-center">
    <h1 class="text-4xl font-bold mb-4"><%= t(".heading") %></h1>
    <p class="text-xl text-base-content/70"><%= t(".subheading") %></p>
  </div>
</section>

<!-- FAQ Content -->
<section class="py-20 bg-base-100">
  <div class="container mx-auto px-4 max-w-4xl">
    <div class="prose prose-lg mx-auto">
      <h2><%= t(".about.heading") %></h2>

      <p><strong><%= t(".about.what_are.question") %></strong><br>
      <%= t(".about.what_are.answer") %></p>

      <p><strong><%= t(".about.migraines.question") %></strong><br>
      <%= t(".about.migraines.answer") %></p>

      <p><strong><%= t(".about.causes.question") %></strong><br>
      <%= t(".about.causes.answer") %></p>

      <h2><%= t(".tracker.heading") %></h2>

      <p><strong><%= t(".tracker.why_built.question") %></strong><br>
      <%= t(".tracker.why_built.answer") %></p>

      <p><strong><%= t(".tracker.how_to_start.question") %></strong><br>
      <%= t(".tracker.how_to_start.answer") %></p>

      <p><strong><%= t(".tracker.different.question") %></strong><br>
      <%= t(".tracker.different.answer") %></p>

      <h2><%= t(".privacy.heading") %></h2>

      <p><strong><%= t(".privacy.private.question") %></strong><br>
      <%= t(".privacy.private.answer") %></p>

      <p><strong><%= t(".privacy.no_email.question") %></strong><br>
      <%= t(".privacy.no_email.answer") %></p>

      <p><strong><%= t(".privacy.export.question") %></strong><br>
      <%= t(".privacy.export.answer") %></p>

      <h2><%= t(".using.heading") %></h2>

      <p><strong><%= t(".using.during_attack.question") %></strong><br>
      <%= t(".using.during_attack.answer") %></p>

      <p><strong><%= t(".using.share.question") %></strong><br>
      <%= t(".using.share.answer") %></p>

      <p><strong><%= t(".using.phone.question") %></strong><br>
      <%= t(".using.phone.answer") %></p>

      <h2><%= t(".support.heading") %></h2>

      <p><strong><%= t(".support.free.question") %></strong><br>
      <%= t(".support.free.answer") %></p>

      <p><strong><%= t(".support.bug.question") %></strong><br>
      <%= t(".support.bug.answer_html", github_link: link_to("GitHub", "https://github.com/crmne/cluster-headache-tracker/issues", class: "link")) %></p>

      <p><strong><%= t(".support.feature.question") %></strong><br>
      <%= t(".support.feature.answer") %></p>
    </div>

    <div class="mt-12 space-y-6">
      <%= render "author_box" %>
      <%= render "medical_disclaimer" %>
    </div>

    <div class="text-center mt-12">
      <%= link_to user_signed_in? ? headache_logs_path : new_user_registration_path, class: "btn btn-lg btn-primary" do %>
        <%= heroicon "arrow-right", variant: "mini", class: "w-5 h-5" %>
        <%= user_signed_in? ? t(".back_to_logs") : t(".start_tracking") %>
      <% end %>
    </div>
  </div>
</section>

<%= render "references", references: [
  {
    name: "World Health Organization - Migraine and other headache disorders",
    url: "https://www.who.int/news-room/fact-sheets/detail/headache-disorders",
    description: t(".references.who")
  },
  {
    name: "Mayo Clinic - Cluster headache diagnosis and treatment",
    url: "https://www.mayoclinic.org/diseases-conditions/cluster-headache/diagnosis-treatment/drc-20352084",
    description: t(".references.mayo_clinic")
  },
  {
    name: "National Headache Foundation - Tracking Diaries",
    url: "https://headaches.org/resources/headache-diary-keeping-a-diary-can-help-your-doctor-help-you/",
    description: t(".references.tracking_diaries")
  }
] %>
