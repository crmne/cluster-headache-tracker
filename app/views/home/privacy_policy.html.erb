<% content_for :title, "Privacy Policy for Cluster Headache Tracker" %>
<article class="prose">
  <h1><%= t(".heading") %></h1>

  <p><%= t(".last_updated", date: l(Date.new(2024, 8, 25), format: :long_date)) %></p>

  <% if I18n.locale != I18n.default_locale %>
    <p><em><%= t(".translation_notice_html", english_version: link_to(t(".english_version"), privacy_policy_path(locale: nil))) %></em></p>
  <% end %>

  <h2><%= t(".introduction.heading") %></h2>
  <p><%= t(".introduction.body") %></p>

  <h2><%= t(".information_we_collect.heading") %></h2>
  <h3><%= t(".information_we_collect.user_provided.heading") %></h3>
  <ul>
    <li><%= t(".information_we_collect.user_provided.username") %></li>
    <li><%= t(".information_we_collect.user_provided.headache_logs") %></li>
  </ul>

  <h3><%= t(".information_we_collect.automatic.heading") %></h3>
  <ul>
    <li><%= t(".information_we_collect.automatic.usage") %></li>
    <li><%= t(".information_we_collect.automatic.device") %></li>
  </ul>
  <p><%= t(".information_we_collect.no_personal_information") %></p>

  <h2><%= t(".how_we_use.heading") %></h2>
  <p><%= t(".how_we_use.intro") %></p>
  <ul>
    <li><%= t(".how_we_use.provide_service") %></li>
    <li><%= t(".how_we_use.insights") %></li>
    <li><%= t(".how_we_use.improve") %></li>
  </ul>

  <h2><%= t(".storage.heading") %></h2>
  <ul>
    <li><%= t(".storage.germany") %></li>
    <li><%= t(".storage.security_measures") %></li>
    <li><%= t(".storage.encryption") %></li>
  </ul>

  <h2><%= t(".sharing.heading") %></h2>
  <ul>
    <li><%= t(".sharing.no_sale") %></li>
    <li><%= t(".sharing.full_control") %></li>
    <li><%= t(".sharing.legal") %></li>
  </ul>

  <h2><%= t(".rights.heading") %></h2>
  <p><%= t(".rights.intro") %></p>
  <ul>
    <li><%= t(".rights.access") %></li>
    <li><%= t(".rights.export") %></li>
    <li><%= t(".rights.share_links") %></li>
  </ul>

  <h2><%= t(".cookies.heading") %></h2>
  <p><%= t(".cookies.body") %></p>

  <h2><%= t(".changes.heading") %></h2>
  <p><%= t(".changes.body") %></p>

  <h2><%= t(".contact.heading") %></h2>
  <p><%= t(".contact.body") %></p>
  <p><a href="mailto:hello@clusterheadachetracker.com">hello@clusterheadachetracker.com</a></p>

  <h2><%= t(".open_source.heading") %></h2>
  <p><a href="https://github.com/crmne/cluster-headache-tracker">https://github.com/crmne/cluster-headache-tracker</a></p>

  <p><%= t(".agreement") %></p>
</article>
