<% content_for :title, "Headache Diary for Neurologist Visits" %>
<% content_for :meta_description, "Prepare a headache diary for neurologist appointments with attack timing, duration, intensity, medication response, oxygen notes, triggers, and reports." %>

<section class="py-16 bg-base-200 sm:py-20">
  <div class="px-4 mx-auto max-w-4xl sm:px-6 lg:px-8 text-center">
    <p class="font-semibold text-primary mb-3"><%= t(".eyebrow") %></p>
    <h1 class="text-4xl font-bold sm:text-5xl"><%= t(".heading") %></h1>
    <p class="mt-6 text-lg text-base-content/70">
      <%= t(".intro") %>
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
      <%= link_to sample_report_path, class: "btn btn-primary btn-lg" do %>
        <%= heroicon "document-chart-bar", variant: "mini", class: "w-5 h-5" %>
        <%= t(".view_sample_report") %>
      <% end %>
      <%= link_to user_signed_in? ? headache_logs_path : new_user_registration_path, class: "btn btn-outline btn-lg" do %>
        <%= heroicon "arrow-right", variant: "mini", class: "w-5 h-5" %>
        <%= t(".start_tracking") %>
      <% end %>
    </div>
  </div>
</section>

<section class="py-16 bg-base-100">
  <div class="px-4 mx-auto max-w-4xl sm:px-6 lg:px-8">
    <div class="prose prose-lg mx-auto">
      <h2><%= t(".what_to_bring.heading") %></h2>
      <p>
        <%= t(".what_to_bring.body") %>
      </p>

      <h2><%= t(".fields.heading") %></h2>
      <ul>
        <li><%= t(".fields.timing") %></li>
        <li><%= t(".fields.intensity") %></li>
        <li><%= t(".fields.treatment") %></li>
        <li><%= t(".fields.symptoms") %></li>
        <li><%= t(".fields.triggers") %></li>
        <li><%= t(".fields.export") %></li>
      </ul>

      <h2><%= t(".reports.heading") %></h2>
      <p>
        <%= t(".reports.body") %>
      </p>
    </div>
  </div>
</section>

<section class="py-12 bg-base-100">
  <div class="px-4 mx-auto max-w-4xl sm:px-6 lg:px-8 text-center">
    <h2 class="text-2xl font-bold mb-3"><%= t(".preview.heading") %></h2>
    <p class="text-base-content/70">
      <%= t(".preview.body") %>
    </p>
    <%= link_to sample_report_path, class: "btn btn-primary mt-6" do %>
      <%= heroicon "document-chart-bar", variant: "mini", class: "w-5 h-5" %>
      <%= t(".view_sample_report") %>
    <% end %>
  </div>
</section>

<section class="py-16 bg-base-200">
  <div class="px-4 mx-auto max-w-4xl sm:px-6 lg:px-8">
    <div class="prose prose-lg mx-auto">
      <h2><%= t(".clinicians.heading") %></h2>
      <p>
        <%= t(".clinicians.body_html", neurologist_page_link: link_to(t(".clinicians.neurologist_page"), neurologist_path, class: "link link-primary")) %>
      </p>
    </div>
  </div>
</section>

<section class="py-12 bg-base-100">
  <div class="px-4 mx-auto max-w-4xl sm:px-6 lg:px-8">
    <%= render "medical_disclaimer" %>
  </div>
</section>

<%= render "references", references: [
  {
    name: "Mayo Clinic - Cluster headache diagnosis and treatment",
    url: "https://www.mayoclinic.org/diseases-conditions/cluster-headache/diagnosis-treatment/drc-20352084",
    description: t(".references.mayo_clinic")
  },
  {
    name: "National Headache Foundation - Tracking Diaries",
    url: "https://headaches.org/resources/headache-diary-keeping-a-diary-can-help-your-doctor-help-you/",
    description: t(".references.tracking_diaries")
  }
] %>

<%= render "seo_cta", headline: t(".cta_headline") %>
