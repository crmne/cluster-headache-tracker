<%- if controller_name != 'sessions' %>
  <%= link_to t("auth.shared.sign_in"), new_session_path(resource_name), class: "inline-block align-baseline font-bold text-sm text-indigo-500 hover:text-indigo-800" %><br>
<% end %>

<%- if devise_mapping.registerable? && controller_name != 'registrations' %>
  <%= link_to t("auth.shared.sign_up"), new_registration_path(resource_name), class: "inline-block align-baseline font-bold text-sm text-indigo-500 hover:text-indigo-800" %><br>
<% end %>
