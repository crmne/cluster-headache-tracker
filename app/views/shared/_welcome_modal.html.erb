<% if user_signed_in? && !current_user.welcome_seen_at? && !mobile_app_update_required? %>
  <dialog id="welcomeModal" class="modal" data-controller="welcome" data-welcome-target="modal">
    <div class="modal-box max-w-md">
      <div class="text-center mb-4">
        <h3 class="text-xl font-bold mb-1"><%= t("layout.welcome_modal.title") %></h3>
        <p class="text-sm text-base-content/70"><%= t("layout.welcome_modal.subtitle") %></p>
      </div>

      <div class="space-y-3 mb-4">
        <div class="flex items-start gap-3">
          <div class="w-8 h-8 bg-primary/20 rounded-full flex items-center justify-center flex-shrink-0">
            <span class="text-xs font-bold">1</span>
          </div>
          <div>
            <h4 class="font-semibold"><%= t("layout.welcome_modal.step_1_title") %></h4>
            <p class="text-xs text-base-content/70"><%= t("layout.welcome_modal.step_1_body") %></p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <div class="w-8 h-8 bg-secondary/20 rounded-full flex items-center justify-center flex-shrink-0">
            <span class="text-xs font-bold">2</span>
          </div>
          <div>
            <h4 class="font-semibold"><%= t("layout.welcome_modal.step_2_title") %></h4>
            <p class="text-xs text-base-content/70"><%= t("layout.welcome_modal.step_2_body") %></p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <div class="w-8 h-8 bg-accent/20 rounded-full flex items-center justify-center flex-shrink-0">
            <span class="text-xs font-bold">3</span>
          </div>
          <div>
            <h4 class="font-semibold"><%= t("layout.welcome_modal.step_3_title") %></h4>
            <p class="text-xs text-base-content/70"><%= t("layout.welcome_modal.step_3_body") %></p>
          </div>
        </div>
      </div>

      <div class="alert alert-warning">
        <%= heroicon "key", class: "w-5 h-5 shrink-0" %>
        <div>
          <p class="text-xs"><%= t("layout.welcome_modal.password_warning_html") %></p>
        </div>
      </div>

      <div class="mt-6">
        <%= render 'shared/personal_note', size: 'compact' %>
      </div>

      <div class="modal-action justify-center mt-4">
        <button class="btn btn-primary btn-wide" data-action="click->welcome#acknowledge" data-welcome-target="startButton" disabled>
          <span data-welcome-target="buttonText"><%= t("layout.welcome_modal.start") %></span>
          <span data-welcome-target="countdown" class="hidden"></span>
        </button>
        <%= button_to t("layout.welcome_modal.start"), settings_welcome_acknowledgement_path,
            form: { class: "hidden", data: { welcome_target: "dismissForm", turbo: false } } %>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button><%= t("layout.modal.close") %></button>
    </form>
  </dialog>
<% end %>
