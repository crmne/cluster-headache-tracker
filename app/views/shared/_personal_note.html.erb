<%
  size ||= 'regular'
  padding_class = size == 'compact' ? 'p-5' : 'p-6 sm:px-8 sm:py-8'
  text_class = size == 'compact' ? 'text-sm' : 'text-lg'
  photo_size_class = size == 'compact' ? 'w-10 h-10' : 'w-11 h-11'
  signature_height_class = size == 'compact' ? 'h-10' : 'h-12'
%>
<div class="max-w-md overflow-hidden bg-base-100 text-base-content shadow-xl border border-base-content/10 -rotate-1">
  <div class="<%= padding_class %>">
    <blockquote class="<%= text_class %> leading-relaxed">
      <p>For tracking when you can barely see. For insurance fights. For showing doctors real data. For finding patterns at 3am.</p>
      <p class="mt-3">I built this because I needed it. Hope it helps you too.</p>
    </blockquote>

    <div class="flex items-center justify-between gap-4 mt-8">
      <div class="flex items-center min-w-0">
        <img
          class="shrink-0 object-cover rounded-full <%= photo_size_class %>"
          src="https://paolino.me/images/me-04_small.jpg"
          alt="Carmine Paolino"
          loading="lazy"
          decoding="async"
        >
        <div class="ml-3 min-w-0">
          <p class="font-bold leading-tight">
            <%= link_to "Carmine Paolino", "https://paolino.me", class: "link link-hover text-current", target: "_blank", rel: "noopener noreferrer" %>
          </p>
          <p class="text-sm text-base-content/60 mt-0.5">Builder</p>
        </div>
      </div>

      <%= image_tag "signature.png",
            class: "w-auto #{signature_height_class} shrink-0",
            alt: "Carmine Paolino signature",
            loading: "lazy",
            decoding: "async" %>
    </div>
  </div>
</div>
