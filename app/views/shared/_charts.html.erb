<% unless headache_logs.any? %>
  <div class="text-center py-12">
    <div class="max-w-md mx-auto">
      <% if params[:start_time].present? || params[:end_time].present? || params[:triggers].present? || params[:medication].present? %>
        <p class="text-xl text-base-content/60 mb-4"><%= t(".no_matches") %></p>
        <%= link_to t(".clear_filters"), charts_path, class: "btn btn-primary" %>
      <% else %>
        <p class="text-xl text-base-content/60 mb-8"><%= t(".no_data") %></p>
        <p class="text-base-content/60 mb-8"><%= t(".first_log_hint_html", new: tag.span(t(".new"), class: "font-bold text-primary")) %></p>
        <div class="flex flex-col items-center" style="height: calc(100vh - env(safe-area-inset-top) - env(safe-area-inset-bottom) - <%= native_app_with_tabs? ? '30rem' : '35rem' %>);">
          <div class="w-1 flex-grow bg-primary/20"></div>
          <svg class="w-12 h-12 text-primary animate-bounce mb-16 -mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </div>
      <% end %>
    </div>
  </div>
<% else %>
  <div data-controller="charts"
       data-charts-intensity-value="<%= chart_data[:intensity_data].to_json %>"
       data-charts-trigger-value="<%= chart_data[:trigger_data].to_json %>"
       data-charts-medication-value="<%= chart_data[:medication_data].to_json %>"
       data-charts-hourly-value="<%= chart_data[:hourly_data].to_json %>"
       data-charts-attacks-per-day-value="<%= chart_data[:attacks_per_day_data].to_json %>"
       data-charts-duration-value="<%= chart_data[:duration_data].to_json %>">
  <div class="grid gap-4 grid-cols-1 mb-4 print:grid-cols-1 print:gap-2">
    <div class="card bg-base-100 shadow-md hover:shadow-lg transition-all duration-200 print:shadow-none print:break-inside-avoid">
      <div class="card-body p-3 sm:p-4">
        <h2 class="text-sm sm:text-base font-semibold flex items-center gap-2">
          <%= heroicon "chart-bar", variant: "mini", class: "w-4 h-4 text-primary" %>
          <%= t(".intensity.title") %>
        </h2>
        <div id="intensityChartContainer" class="h-[300px] print:h-[200px] print:max-w-full" data-charts-target="container">
          <% if chart_data[:intensity_data].any? %>
            <canvas id="intensityChart" data-charts-target="intensityCanvas"></canvas>
          <% else %>
            <p class="text-sm text-base-content/60"><%= t(".intensity.no_data") %></p>
          <% end %>
          <div class="loading-spinner hidden"></div>
        </div>
      </div>
    </div>

    <div class="card bg-base-100 shadow-md hover:shadow-lg transition-all duration-200 print:shadow-none print:break-inside-avoid">
      <div class="card-body p-3 sm:p-4">
        <h2 class="text-sm sm:text-base font-semibold flex items-center gap-2">
          <%= heroicon "calendar", variant: "mini", class: "w-4 h-4 text-secondary" %>
          <%= t(".attacks_per_day.title") %>
        </h2>
        <div id="attacksPerDayChartContainer" class="h-[300px] print:h-[200px] print:max-w-full" data-charts-target="container">
          <% if chart_data[:attacks_per_day_data].any? %>
            <canvas id="attacksPerDayChart" data-charts-target="attacksPerDayCanvas"></canvas>
          <% else %>
            <p class="text-sm text-base-content/60"><%= t(".attacks_per_day.no_data") %></p>
          <% end %>
          <div class="loading-spinner hidden"></div>
        </div>
      </div>
    </div>

    <div class="card bg-base-100 shadow-md hover:shadow-lg transition-all duration-200 print:shadow-none print:break-inside-avoid">
      <div class="card-body p-3 sm:p-4">
        <h2 class="text-sm sm:text-base font-semibold flex items-center gap-2">
          <%= heroicon "clock", variant: "mini", class: "w-4 h-4 text-info" %>
          <%= t(".duration.title") %>
        </h2>
        <div id="durationChartContainer" class="h-[300px] print:h-[200px] print:max-w-full" data-charts-target="container">
          <% if chart_data[:duration_data].any? %>
            <canvas id="durationChart" data-charts-target="durationCanvas"></canvas>
          <% else %>
            <p class="text-sm text-base-content/60"><%= t(".duration.no_data") %></p>
          <% end %>
          <div class="loading-spinner hidden"></div>
        </div>
      </div>
    </div>

    <div class="card bg-base-100 shadow-md hover:shadow-lg transition-all duration-200 print:shadow-none print:break-inside-avoid">
      <div class="card-body p-3 sm:p-4">
        <h2 class="text-sm sm:text-base font-semibold flex items-center gap-2">
          <%= heroicon "sun", variant: "mini", class: "w-4 h-4 text-warning" %>
          <%= t(".hourly.title") %>
        </h2>
        <div id="hourlyChartContainer" class="h-[300px] print:h-[200px] print:max-w-full" data-charts-target="container">
          <% if chart_data[:hourly_data].any? %>
            <canvas id="hourlyChart" data-charts-target="hourlyCanvas"></canvas>
          <% else %>
            <p class="text-sm text-base-content/60"><%= t(".hourly.no_data") %></p>
          <% end %>
          <div class="loading-spinner hidden"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="grid gap-4 grid-cols-1 md:grid-cols-2 mb-8 print:grid-cols-2">
    <div class="card bg-base-100 shadow-md hover:shadow-lg transition-all duration-200 print:shadow-none print:break-inside-avoid">
      <div class="card-body p-3 sm:p-4">
        <h2 class="text-sm sm:text-base font-semibold flex items-center gap-2">
          <%= heroicon "bolt", variant: "mini", class: "w-4 h-4 text-secondary" %>
          <%= t(".triggers.title") %>
        </h2>
        <div id="triggerChartContainer" class="h-[300px] print:max-w-full" data-charts-target="container">
          <% if chart_data[:trigger_data].any? %>
            <canvas id="triggerChart" data-charts-target="triggerCanvas"></canvas>
          <% else %>
            <p class="text-sm text-base-content/60"><%= t(".triggers.no_data") %></p>
          <% end %>
          <div class="loading-spinner hidden"></div>
        </div>
      </div>
    </div>

    <div class="card bg-base-100 shadow-md hover:shadow-lg transition-all duration-200 print:shadow-none print:break-inside-avoid">
      <div class="card-body p-3 sm:p-4">
        <h2 class="text-sm sm:text-base font-semibold flex items-center gap-2">
          <%= heroicon "beaker", variant: "mini", class: "w-4 h-4 text-primary" %>
          <%= t(".medications.title") %>
        </h2>
        <div id="medicationChartContainer" class="h-[300px] print:max-w-full" data-charts-target="container">
          <% if chart_data[:medication_data].any? %>
            <canvas id="medicationChart" data-charts-target="medicationCanvas"></canvas>
          <% else %>
            <p class="text-sm text-base-content/60"><%= t(".medications.no_data") %></p>
          <% end %>
          <div class="loading-spinner hidden"></div>
        </div>
      </div>
    </div>
  </div>
  </div>
<% end %>
