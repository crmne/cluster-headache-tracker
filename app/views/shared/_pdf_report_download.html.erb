<%# locals: (url:) %>
<% filters = request.query_parameters.slice(*HeadacheLog::Report::FILTERS.map(&:to_s)) %>

<%# Native shells only show this once they handle the "download" bridge component. %>
<button type="button"
        class="btn btn-outline btn-sm print:hidden <%= "native-download" if hotwire_native_app? %>"
        title="<%= t("pdf_reports.download.button") %>"
        aria-label="<%= t("pdf_reports.download.button") %>"
        onclick="pdf_report_modal.showModal()">
  <%= heroicon "document-arrow-down", variant: "mini", class: "w-4 h-4" %>
  <span><%= t("pdf_reports.download.short") %></span>
</button>

<dialog id="pdf_report_modal" class="modal modal-bottom sm:modal-middle print:hidden">
  <div class="modal-box">
    <h3 class="text-lg font-bold"><%= t("pdf_reports.download.heading") %></h3>
    <p class="py-2 text-sm text-base-content/70"><%= t("pdf_reports.download.description") %></p>

    <%= form_with url: url, method: :get,
          html: { onsubmit: "this.closest('dialog').close()" },
          data: { turbo: false, controller: "bridge--download", action: "submit->bridge--download#download", download_title: t("pdf_reports.title") } do |form| %>
      <% filters.each do |name, value| %>
        <%= hidden_field_tag name, value, id: nil %>
      <% end %>

      <div class="space-y-3 mt-2">
        <div>
          <%= form.label :patient_name, t("pdf_reports.download.patient_name"), class: "text-sm font-medium mb-1 block" %>
          <%= form.text_field :patient_name, maxlength: 100, autocomplete: "off", placeholder: t("pdf_reports.download.patient_name_placeholder"), class: "input input-bordered w-full" %>
        </div>

        <div>
          <%= form.label :prepared_for, t("pdf_reports.download.prepared_for"), class: "text-sm font-medium mb-1 block" %>
          <%= form.text_field :prepared_for, maxlength: 100, autocomplete: "off", placeholder: t("pdf_reports.download.prepared_for_placeholder"), class: "input input-bordered w-full" %>
        </div>
      </div>

      <div class="modal-action">
        <button type="button" class="btn btn-ghost" onclick="pdf_report_modal.close()"><%= t("pdf_reports.download.cancel") %></button>
        <%= form.button type: "submit", name: nil, class: "btn btn-primary" do %>
          <%= heroicon "arrow-down-tray", variant: "mini", class: "w-4 h-4" %>
          <%= t("pdf_reports.download.submit") %>
        <% end %>
      </div>
    <% end %>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button><%= t("pdf_reports.download.cancel") %></button>
  </form>
</dialog>
