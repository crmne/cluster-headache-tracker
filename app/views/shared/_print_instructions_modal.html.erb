<dialog id="print_instructions" class="modal print:hidden">
  <div class="modal-box">
    <h3 class="font-bold text-lg mb-4"><%= t(".title") %></h3>
    <div class="space-y-2">
      <p><%= t(".step_1") %></p>
      <p><%= t(".step_2") %></p>
      <p><%= t(".step_3") %></p>
    </div>
    <div class="modal-action">
      <button class="btn btn-primary" onclick="window.print()"><%= t(".print_now") %></button>
      <form method="dialog">
        <button class="btn"><%= t(".close") %></button>
      </form>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button><%= t(".close") %></button>
  </form>
</dialog>
