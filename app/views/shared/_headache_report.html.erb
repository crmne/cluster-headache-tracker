<% show_filters = local_assigns.fetch(:show_filters, true) %>
<% show_print_instructions = local_assigns.fetch(:show_print_instructions, true) %>
<% live_updates = local_assigns.fetch(:live_updates, true) %>
<%# Photos are for the owner's own report only: share links never include them. %>
<% show_photos = local_assigns.fetch(:show_photos, false) %>
<% report_title = local_assigns.fetch(:report_title) { t(".title", username: user.username) } %>
<% generated_on = local_assigns.fetch(:generated_on) { Current.today } %>

<% if show_filters %>
  <div class="print:hidden join join-vertical w-full mb-4">
    <%= render "shared/filter_form", user: user %>
  </div>
<% end %>

<div class="mb-8">
  <h1 class="text-3xl font-bold mb-2 print:text-2xl"><%= report_title %></h1>
  <p class="text-base-content/70 print:text-black"><%= t(".generated_html", site: link_to("clusterheadachetracker.com", "https://clusterheadachetracker.com", class: "link link-hover print:no-underline print:text-black"), date: l(generated_on, format: :long_date)) %></p>
</div>

<%= render "shared/print_instructions_modal" if show_print_instructions %>

<%= render "headache_logs/stats", headache_logs: headache_logs %>

<h2 class="text-2xl font-bold mb-4"><%= t(".analysis") %></h2>
<%= render partial: 'shared/charts', locals: { headache_logs: headache_logs, chart_data: chart_data, medication_insights: local_assigns[:medication_insights] } %>

<h2 class="text-2xl font-bold mb-4 mt-8"><%= t(".entries") %></h2>
<%= turbo_stream_from user, "headache_logs" if live_updates %>
<%= render "headache_logs/table", headache_logs: headache_logs, hide_actions: true %>
<%= render "shared/report_photos", headache_logs: headache_logs if show_photos %>
