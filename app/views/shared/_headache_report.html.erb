<% show_filters = local_assigns.fetch(:show_filters, true) %>
<% show_print_instructions = local_assigns.fetch(:show_print_instructions, true) %>
<% live_updates = local_assigns.fetch(:live_updates, true) %>
<% report_title = local_assigns.fetch(:report_title, "Cluster Headache Report for #{user.username}") %>
<% generated_on = local_assigns.fetch(:generated_on, Date.today) %>

<% if show_filters %>
  <div class="print:hidden join join-vertical w-full mb-4">
    <%= render "shared/filter_form" %>
  </div>
<% end %>

<div class="mb-8">
  <h1 class="text-3xl font-bold mb-2 print:text-2xl"><%= report_title %></h1>
  <p class="text-base-content/70 print:text-black">Generated by <%= link_to "clusterheadachetracker.com", "https://clusterheadachetracker.com", class: "link link-hover print:no-underline print:text-black" %> on <%= generated_on %></p>
</div>

<%= render "shared/print_instructions_modal" if show_print_instructions %>

<%= render "headache_logs/stats", headache_logs: headache_logs %>

<h2 class="text-2xl font-bold mb-4">Analysis</h2>
<%= render partial: 'shared/charts', locals: { headache_logs: headache_logs, chart_data: chart_data } %>

<h2 class="text-2xl font-bold mb-4 mt-8">Detailed Log Entries</h2>
<%= turbo_stream_from user, "headache_logs" if live_updates %>
<%= render "headache_logs/table", headache_logs: headache_logs, hide_actions: true %>
