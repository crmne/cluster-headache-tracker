<% content_for :title, t(".title") %>
<% content_for :navbar, t(".title") %>

<%= render 'shared/back', back_path: headache_logs_path %>

<% if bridge_component_supported?("menu") %>
  <div data-controller="bridge--menu" hidden>
    <%= link_to t(".edit"), edit_headache_log_path(@headache_log),
          data: { bridge__menu_target: "item", bridge_ios_image: "pencil", bridge_android_image: "edit" } %>
    <%= button_to t(".delete"), headache_log_path(@headache_log), method: :delete,
          data: {
            bridge__menu_target: "item",
            bridge_ios_image: "trash",
            bridge_android_image: "delete",
            bridge_destructive: true,
            turbo_confirm: t("headache_logs.delete_confirmation")
          } %>
  </div>
<% end %>

<%= render @headache_log, hide_actions: bridge_component_supported?("menu") %>

<%= render "headache_logs/photos", headache_log: @headache_log %>
