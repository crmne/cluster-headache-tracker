{
  "name": "Cluster Headache Tracker",
  "short_name": "CH Tracker",
  "description": "Track and manage your cluster headaches",
  "start_url": "/headache_logs",
  "display": "standalone",
  "background_color": "#4f46e5",
  "theme_color": "#4f46e5",
  "icons": [
    {
      "src": "<%= asset_path 'favicon/android-chrome-192x192.png' %>",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "<%= asset_path 'favicon/android-chrome-512x512.png' %>",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "shortcuts": [
    {
      "name": <%== t("pwa.shortcuts.quick_log.name").to_json %>,
      "short_name": <%== t("pwa.shortcuts.quick_log.short_name").to_json %>,
      "description": <%== t("pwa.shortcuts.quick_log.description").to_json %>,
      "url": "<%= new_headache_log_path(quick: 1) %>",
      "icons": [{ "src": "<%= asset_path 'shortcuts/quick-log.png' %>", "sizes": "192x192", "type": "image/png", "purpose": "any" }]
    },
    {
      "name": <%== t("pwa.shortcuts.current_attack.name").to_json %>,
      "short_name": <%== t("pwa.shortcuts.current_attack.short_name").to_json %>,
      "description": <%== t("pwa.shortcuts.current_attack.description").to_json %>,
      "url": "<%= current_attack_path %>",
      "icons": [{ "src": "<%= asset_path 'shortcuts/current-attack.png' %>", "sizes": "192x192", "type": "image/png", "purpose": "any" }]
    },
    {
      "name": "View Charts",
      "short_name": "Charts",
      "description": "View headache charts and analytics",
      "url": "/charts",
      "icons": [{ "src": "<%= asset_path 'favicon/android-chrome-192x192.png' %>", "sizes": "192x192" }]
    }
  ]
}
