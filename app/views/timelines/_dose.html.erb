<%# locals: (dose:) %>
<span class="absolute -left-[7px] top-2.5 w-3 h-3 rounded-full ring-4 ring-base-200" style="background-color: <%= dose.medication.display_color %>;" aria-hidden="true"></span>
<%= link_to edit_medication_dose_path(dose), class: "flex flex-wrap items-center gap-2 py-1 hover:opacity-80", id: dom_id(dose, :timeline) do %>
  <span class="text-sm text-base-content/70 tabular-nums"><%= l(dose.taken_at, format: :medication_dose_time) %></span>
  <%= dose_tag dose %>
  <%= effectiveness_badge dose %>
<% end %>
