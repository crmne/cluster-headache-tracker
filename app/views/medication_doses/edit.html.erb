<% content_for :title, t("medication_doses.edit.title", name: @medication_dose.medication.name) %>
<% content_for :navbar, t("medication_doses.edit.title", name: @medication_dose.medication.name) %>

<% unless hotwire_native_app? %>
  <%= render "shared/back", back_path: timeline_path %>
<% end %>

<div class="card bg-base-100 shadow-md">
  <div class="card-body p-3 sm:p-4">
    <%= render "form", medication_dose: @medication_dose, medications: current_user.medications.alphabetically %>
  </div>
</div>

<%= button_to medication_dose_path(@medication_dose), method: :delete,
      class: "btn btn-outline btn-error w-full mt-4",
      data: { turbo_confirm: t("medication_doses.destroy.confirm") } do %>
  <%= heroicon "trash", variant: "mini", class: "w-4 h-4" %>
  <%= t("medication_doses.destroy.button") %>
<% end %>
